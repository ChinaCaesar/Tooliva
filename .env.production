# -----------------------------------------------------------------------------
# Tooliva - development environment
# -----------------------------------------------------------------------------
# 说明：
# 1. 这里的变量同时服务于前端页面展示与 Tauri 桌面端运行。
# 2. AI 运行时相关地址严禁写死在代码里，必须通过环境变量注入。
# 3. 如果未配置 AI 运行时 CDN，页面会显示“当前电脑支持，但当前版本未配置一键下载源”，
#    并禁用“一键安装 AI 组件”按钮；极速模式仍可正常使用。
# -----------------------------------------------------------------------------

# Web 站点根地址。
# 用途：前端拼接默认 API 地址、登录跳转、部分外链回跳。
PUBLIC_SITE_URL=https://tool.toolivaai.com/

# API 服务域名/端口，不含 path。
# 例如本地开发后端通常是 http://localhost:8000
PUBLIC_API_ORIGIN=https://toolserver.toolivaai.com/index.php

# API 基础路径。
# 会与 PUBLIC_API_ORIGIN 拼成完整 API 地址：${PUBLIC_API_ORIGIN}${PUBLIC_API_BASE_PATH}
PUBLIC_API_BASE_PATH=/api

# 静态资源根地址。
# 用于图片、素材等公共资源；如果前后端同源，可与 API 服务保持一致。
PUBLIC_ASSET_BASE_URL=https://toolserver.toolivaai.com

# 前端可见的网站地址。
# 一般与 PUBLIC_SITE_URL 保持一致；桌面端有时需要单独覆盖，所以单列一个 VITE_* 变量。
VITE_WEBSITE_URL=https://tool.toolivaai.com/

# 前端直接调用的 API 完整根地址。
# 若不填，代码会尝试由 PUBLIC_API_ORIGIN + PUBLIC_API_BASE_PATH 自动拼接。
VITE_API_BASE_URL=https://toolserver.toolivaai.com/index.php/api

# AI 运行时远程 manifest 地址。
# 这是“客户端一键安装/升级 AI 组件”最关键的入口。
# 客户端会先请求这个 JSON，再读取：
# - runtime_version
# - package_url
# - package_sha256
# - required_free_disk_gb
# - models[].url / sha256 / size
#
# 开发/测试示例：
# VITE_AI_RUNTIME_MANIFEST_URL=https://cdn.example.com/ai-runtime/manifest.json
#
# 为空时的行为：
# - 环境检测仍会执行
# - 如果当前电脑满足要求，界面会提示“未配置一键下载源”
# - 不会真的发起安装下载
# 当前开发环境说明：
# - 这里使用本机 `http://localhost/ToolivaData/...` 代理静态资源，便于快速联调
# - 这不是 Vite 内建 proxy；资源是否可用取决于本机 80 端口上的代理/静态服务
# - manifest.json 内部的 package_url / models[].url / sha256 也必须与本地代理内容保持一致

# AI 运行时 CDN 根目录，仅作为发布约定与排查用配置保留。
# 当前前端逻辑主要依赖 manifest 中的 package_url / model url；
# 但建议仍配置该值，便于统一运维约定，例如：
# VITE_AI_RUNTIME_BASE_URL=https://cdn.example.com/ai-runtime
#
# 推荐目录约定：
# ${VITE_AI_RUNTIME_BASE_URL}/manifest.json
# ${VITE_AI_RUNTIME_BASE_URL}/windows-x64/1.0.0/ai-runtime.zip
# 当前开发环境下它主要作为“本地代理根路径”备注保留；
# 实际安装仍然以 manifest.json 中的 package_url / model url 为准。

# 是否启用 AI 运行时安装/检测功能。
# true  : 显示 AI 增强模式、执行环境检测、允许读取远程 manifest
# false : 前端直接视为禁用 AI 运行时，只保留极速模式
VITE_AI_RUNTIME_ENABLED=true

# 安装 AI 运行时前要求的最小可用磁盘空间（GB）。
# 会在进入 AI 增强模式时参与本机环境校验。
# 建议值 >= 8；如果你的运行时包更大，可继续上调。
VITE_AI_RUNTIME_MIN_FREE_DISK_GB=8

# 运行时发布通道。
# 常见值：
# - stable   稳定版
# - beta     测试版
# - internal 内部验证版
# 当前前端主要用于显示和版本语义对齐，真正安装内容仍以 manifest 为准。
